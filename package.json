{
  "name": "geoyun",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api": "npm run admin:api",
    "admin:api": "py -3.11 -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8001",
    "admin:worker": "py -3.11 -m celery -A backend.app.celery_app worker --loglevel=info --pool=solo",
    "admin:test": "py -3.11 -m pytest backend/tests -q",
    "admin:lint": "py -3.11 -m ruff check backend && npx.cmd eslint src/components/BackendUserAdmin.jsx src/services/adminUserApi.js src/main.jsx vite.config.js",
    "dev": "vite",
    "dev:full": "concurrently \"npm:admin:api\" \"npm:admin:worker\" \"npm:dev\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "node --check src/utils/accessControl.js && node --check src/services/authApi.js && node --check src/services/adminProjectApi.js && node --check src/services/adminUserApi.js"
  },
  "dependencies": {
    "antd": "^6.3.6",
    "concurrently": "^9.2.1",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.6.205",
    "proj4": "^2.20.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.14.2",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^2.2.7",
    "tslib": "^2.8.1",
    "xlsx": "^0.18.5",
    "zrender": "^6.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.4",
    "vitest": "^3.2.4"
  }
}
