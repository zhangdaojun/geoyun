# =============================================
# GeoYun Environment Variables
# Copy this file to .env and fill in your values.
# =============================================

# ---- FastAPI Admin Server ----
ADMIN_DATABASE_URL=sqlite:///./dev-admin.sqlite3
ADMIN_SQL_ECHO=0
ADMIN_SEED_ACCOUNT=admin
ADMIN_SEED_PHONE=13800000000
ADMIN_SEED_NAME=超级管理员
ADMIN_SEED_COMPANY=吉云科技

# ---- EMAP1 / Aurora Processing ----
ADMIN_REDIS_URL=redis://127.0.0.1:6379/0
ADMIN_CELERY_RESULT_EXPIRES=86400
ADMIN_EMAP1_ENGINE=auto
ADMIN_AURORA_COMMAND=
ADMIN_AURORA_ARGS=
ADMIN_AURORA_TIMEOUT_SEC=120
ADMIN_AURORA_FALLBACK_TO_LEGACY=1

# ---- Vite Frontend ----
VITE_ADMIN_API_BASE_URL=http://127.0.0.1:8001/admin
